{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["bin/**/*.mjs", "cli/**/*.mjs", "cli/**/*.mts"],
  "exclude": ["cli/types.mjs", "cli/workflows/*.mjs", "cli/domain/*.mjs"]
}
